<resources>

	<!-- Base application theme. -->
	<style name="AppTheme" parent="Theme.Material3.DayNight.NoActionBar">
		<!-- Customize your theme here. -->
		<item name="colorPrimary">@color/colorPrimary</item>
		<item name="colorPrimaryDark">@color/colorPrimaryDark</item>
		<item name="colorAccent">@color/colorAccent</item>
	</style>

	<style name="TextDetail" parent="TextAppearance.AppCompat.Medium">

	</style>

	<style name="TextTitle" parent="TextAppearance.AppCompat.Body1">
		<item name="android:textColor">@color/titleTextColor</item>
		<item name="android:textSize">18sp</item>
		<item name="android:fontFamily">@font/plus_jakarta_sans_bold</item>
	</style>

	<style name="TextRegularTitle" parent="TextAppearance.AppCompat.Body2">
		<item name="android:textColor">@color/subTextColor</item>
		<item name="android:textSize">14sp</item>
		<item name="android:fontFamily">@font/plus_jakarta_sans</item>
	</style>

	<style name="TextMediumBody" parent="TextAppearance.AppCompat.Body2">
		<item name="android:textColor">@color/titleTextColor</item>
		<item name="android:textSize">16sp</item>
		<item name="android:fontFamily">@font/plus_jakarta_sans_medium</item>
	</style>

</resources>
